# Application Configuration
NODE_ENV=development
PORT=3000
GLOBAL_PREFIX=petiqa

# MongoDB Configuration (REQUIRED)
# Update this with your actual MongoDB connection string
# Examples:
# - Local: mongodb://localhost:27017/petiqa
# - Atlas: mongodb+srv://username:password@cluster.mongodb.net/petiqa
MONGODB_URI=mongodb://localhost:27017/petiqa

# Swagger Documentation
ENABLE_SWAGGER=true
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin
