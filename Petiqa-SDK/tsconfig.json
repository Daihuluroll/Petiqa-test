{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "petiqa-sdk": ["src/index"]
    },
    "types": ["@react-navigation/native"]   
  },
  "include": [
    "src",
    "src/types/**/*.d.ts"                   
  ],
  "exclude": ["node_modules", "dist", "example"]
}
