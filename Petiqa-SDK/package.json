{
  "name": "petiqa-sdk",
  "version": "1.0.0",
  "description": "SDK for integrating Petiqa game into other applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
  "build": "tsc",
  "test": "jest",
  "prepare": "node -e \"const fs=require('fs'); if (fs.existsSync('src')) { require('child_process').execSync('npm run build', {stdio: 'inherit'}); } else { console.log('no src folder, skipping build'); }\""
  },
  "peerDependencies": {
    "react": "18.2.0",
    "react-native": "0.74.x",
    "@react-native-async-storage/async-storage": "*",
    "@react-navigation/native": "*",
    "@react-navigation/stack": "*",
    "react-native-safe-area-context": "*",
    "react-native-screens": "*"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-navigation/native": "6.1.7",
    "@react-navigation/stack": "6.3.1",
    "@react-native-community/slider": "4.5.2",
    "axios": "1.7.4",
    "react-native-fast-image": "8.6.3",
    "react-native-game-engine": "1.2.0",
    "matter-js": "0.20.0",
    "react-native-sensors": "7.3.6",
    "react-native-sound-player": "0.14.3",
    "mongodb": "6.8.0",
    "mongoose": "8.5.2",
    "moongoose": "0.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.6",
    "@types/react-native": "^0.72.0",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "jest": "^29.6.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  }
}
